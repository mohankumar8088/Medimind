# Optional. Keep the actual key in backend/.env, never in frontend source.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MongoDB Atlas connection string from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=medimind

# Generate a random secret of at least 32 characters. Keep this private.
JWT_SECRET_KEY=
